#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

bin=target/release/formslot-cli
if [ ! -x "$bin" ] || [ -n "$(find cli core Cargo.toml Cargo.lock -newer "$bin" \( -name '*.rs' -o -name '*.sql' -o -name '*.toml' -o -name '*.lock' \) 2>/dev/null | head -1)" ]; then
  command -v cargo >/dev/null || { echo "Rust is required: https://rustup.rs. Then run ./formslot_oc_install" >&2; exit 1; }
  cargo build -q --release --locked -p formslot-cli >&2
fi
exec "$bin" "$@"
