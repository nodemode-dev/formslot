  "invariants": [
    {
      "id": "tokens-only",
      "text": "Every colour, space and radius comes from a token in the studio-dark token set (var(--bg-*), var(--text-*), var(--border-*), var(--space-*), var(--radius-*)); no literal colour values in component code.",
      "severity": "must"
    },
    {
      "id": "z-scale",
      "text": "Stacking above local ordering uses var(--z-*) from the one z scale; a raw numeric z-index is not allowed.",
      "severity": "must"
    },
    {
      "id": "no-scrollbars",
      "text": "No scrollbar is ever drawn anywhere (the owner rule); content still scrolls by wheel, trackpad, touch and keys.",
      "severity": "must"
    },
    {
      "id": "light-is-override",
      "text": "Light mode is the body.theme-light override layer on top of the dark default, never a separate stylesheet set.",
      "severity": "must"
    }
