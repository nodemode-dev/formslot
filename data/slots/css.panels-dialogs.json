  "examples": [
    {
      "title": "Scrollbars removed everywhere",
      "language": "css",
      "snippet": "*, *::before, *::after { scrollbar-width: none !important; -ms-overflow-style: none !important; }\n*::-webkit-scrollbar, *::-webkit-scrollbar-button, *::-webkit-scrollbar-track, *::-webkit-scrollbar-thumb, *::-webkit-scrollbar-corner {\n  display: none !important; width: 0 !important; height: 0 !important; background: transparent !important;\n}\nhtml, body { scrollbar-width: none !important; }",
      "whenToUse": "When a new form app needs the same no-scrollbar look."
    },
    {
      "title": "Font imports",
      "language": "css",
      "snippet": "@import \"@fontsource/inter/400.css\";\n@import \"@fontsource/inter/500.css\";\n@import \"@fontsource/inter/600.css\";\n@import \"@fontsource/jetbrains-mono/400.css\";\n@import \"@fontsource/jetbrains-mono/700.css\";",
      "whenToUse": "When loading the family fonts in a new app."
    }
