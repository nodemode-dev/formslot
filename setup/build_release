#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

usage() {
  cat <<'USAGE'
setup/build_release          build the release binary and stage dist/formslot-vX.Y.Z-<os>-<arch>/ and its .tar.gz
                             on Linux, also dist/formslot-vX.Y.Z-linux-<arch>.zip, the file FormPortal installs (needs zip)
  --dmg                      on macOS, also pack the staged folder into dist/formslot-vX.Y.Z-macos-<arch>.dmg
  FORMSLOT_DIST_DIR=<dir>    stage somewhere other than ./dist
  CARGO_TARGET_DIR=<dir>     build somewhere other than ./target
  APPLE_SIGNING_IDENTITY=<identity>
                             on macOS, sign the binary with this identity (hardened runtime, secure timestamp)
                             before the checksums are written; the identity must be in a keychain on the search list
On Windows run setup\build_release.bat. The version is the workspace version in Cargo.toml.
USAGE
}

dmg=0
case "${1:-}" in
  "") ;;
  --dmg) dmg=1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

die() { echo "[formslot] $*" >&2; exit 1; }
say() { echo "[formslot] $*"; }

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env" || true
command -v cargo >/dev/null || die "Rust 1.90 or newer is required: https://rustup.rs"

case "$(uname -s)" in
  Darwin) os=macos ;;
  Linux) os=linux ;;
  *) die "build_release runs on macOS and Linux; on Windows run setup\\build_release.bat" ;;
esac
[ "$dmg" = 0 ] || [ "$os" = macos ] || die "--dmg makes a macOS disk image and runs on macOS only"
case "$(uname -m)" in
  x86_64|amd64) arch=x86_64 ;;
  arm64|aarch64) arch=aarch64 ;;
  *) arch="$(uname -m)" ;;
esac

version="$(sed -n 's/^version = "\([0-9][0-9.]*\)".*/\1/p' Cargo.toml | head -1)"
[ -n "$version" ] || die "no workspace version found in Cargo.toml"

say "building formslot-cli v$version for $os-$arch"
cargo build --release --locked -p formslot-cli

bin="${CARGO_TARGET_DIR:-target}/release/formslot-cli"
[ -x "$bin" ] || die "the release binary is missing at $bin"
if [ "$os" = macos ] && "$bin" dense status >/dev/null 2>&1; then
  die "this program was built with the dense feature; a macOS release is built without it, because the hardened runtime refuses the ONNX Runtime library it loads unless the program is signed with the disable-library-validation entitlement"
fi

dist="${FORMSLOT_DIST_DIR:-$root/dist}"
name="formslot-v$version-$os-$arch"
stage="$dist/$name"
rm -rf "$stage" "$dist/$name.tar.gz" "$dist/$name.dmg" "$dist/$name.zip" "$dist/$name.zip.sha256"
[ "$os" != linux ] || command -v zip >/dev/null || die "zip is required for the Linux .zip (for example: sudo apt install zip)"
mkdir -p "$stage/plugin" "$stage/data"

cp "$bin" "$stage/formslot"
chmod 755 "$stage/formslot"
if [ "$os" = macos ] && [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
  codesign --force --options runtime --timestamp --sign "$APPLE_SIGNING_IDENTITY" "$stage/formslot"
  codesign --verify --strict "$stage/formslot"
  say "signed $stage/formslot"
fi
cp LICENSE NOTICE.md README.md formslot_oc_install "Install formslot.command" "$stage/"
chmod 755 "$stage/formslot_oc_install" "$stage/Install formslot.command"
cp -R plugin/formslot "$stage/plugin/formslot"
cp -R data/. "$stage/data/"

if command -v sha256sum >/dev/null; then sum() { sha256sum "$@"; }; else sum() { shasum -a 256 "$@"; }; fi
( cd "$stage" && find . -type f ! -name SHA256SUMS | sed 's|^\./||' | LC_ALL=C sort | while IFS= read -r f; do sum "$f"; done > SHA256SUMS )

( cd "$dist" && tar -czf "$name.tar.gz" "$name" )
( cd "$dist" && sum "$name.tar.gz" > "$name.tar.gz.sha256" )
if [ "$os" = linux ]; then
  ( cd "$dist" && zip -q -r -y -X "$name.zip" "$name" )
  ( cd "$dist" && sum "$name.zip" > "$name.zip.sha256" )
fi
if [ "$dmg" = 1 ]; then
  hdiutil create -quiet -volname "$name" -srcfolder "$stage" -ov -format UDZO "$dist/$name.dmg"
fi

say "staged $stage"
say "archive $dist/$name.tar.gz"
[ "$os" != linux ] || say "zip $dist/$name.zip"
[ "$dmg" = 0 ] || say "disk image $dist/$name.dmg"
